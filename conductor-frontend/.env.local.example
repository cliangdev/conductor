NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public origin of this frontend (production: https://conductor.rexipe.io).
# Powers absolute Open Graph image URLs and the canonical links on the public marketing pages
# (/, /privacy, /terms), which platform app reviewers check. Falls back to http://localhost:3000.
# Baked in at build time (Dockerfile ARG), so changing it needs a redeploy, not a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
