{
  "schemaVersion": 1,
  "id": "MARKETING",
  "area": "MARKETING",
  "version": 1,
  "state": "PUBLISHED",
  "noun": "Post",
  "default_view": "calendar",
  "types": ["POST"],
  "asset_types": ["facebook_post", "instagram_post", "youtube_video", "tiktok_post"],
  "publishes_from": "SCHEDULED",
  "metric": null,
  "statuses": [
    { "id": "DRAFT", "label": "Draft", "category": "open", "initial": true },
    { "id": "IN_REVIEW", "label": "In Review", "category": "in_progress" },
    { "id": "CHANGES_REQUESTED", "label": "Changes Requested", "category": "in_progress" },
    { "id": "APPROVED", "label": "Approved", "category": "in_progress" },
    { "id": "SCHEDULED", "label": "Scheduled", "category": "in_progress" },
    { "id": "PUBLISHED", "label": "Published", "category": "terminal", "terminal": true },
    { "id": "FAILED", "label": "Failed", "category": "in_progress" }
  ],
  "transitions": [
    { "from": "DRAFT", "to": "IN_REVIEW", "label": "Submit for review" },
    {
      "from": "IN_REVIEW",
      "to": "APPROVED",
      "trigger": "review_approved",
      "label": "Approve",
      "requiresReview": true,
      "reviewOutcomes": ["approve", "request_changes"],
      "reviewerRole": "REVIEWER"
    },
    { "from": "IN_REVIEW", "to": "CHANGES_REQUESTED", "label": "Request changes" },
    { "from": "CHANGES_REQUESTED", "to": "IN_REVIEW", "label": "Resubmit" },
    { "from": "APPROVED", "to": "SCHEDULED", "label": "Schedule", "trigger": "review_approved" },
    { "from": "APPROVED", "to": "IN_REVIEW", "label": "Send back" },
    { "from": "SCHEDULED", "to": "APPROVED", "label": "Unschedule" },
    { "from": "SCHEDULED", "to": "PUBLISHED", "label": "Published" },
    { "from": "SCHEDULED", "to": "FAILED", "label": "Publish failed" },
    { "from": "FAILED", "to": "SCHEDULED", "label": "Retry" }
  ]
}
