{
  "description": "Organic search performance from Google Search Console: clicks, impressions, top queries, top pages",
  "operations": [
    {
      "id": "search_analytics",
      "description": "Daily click/impression trend (90d), branded share, top 50 queries, top 25 pages, top 10 countries, device breakdown (28d)",
      "params": {
        "siteUrl": "Search Console property URL (e.g. sc-domain:example.com)"
      },
      "outputShape": {
        "trend": [
          { "date": "2026-06-01", "clicks": 420, "impressions": 8900, "ctr": 0.047, "position": 18.3 }
        ],
        "topQueries": [
          { "query": "example keyword", "clicks": 210, "impressions": 3400, "ctr": 0.062, "position": 7.1 }
        ],
        "topPages": [
          { "page": "https://example.com/blog/post", "clicks": 180, "impressions": 2100 }
        ],
        "brandedClickShare": 0.31,
        "countries": [
          { "country": "usa", "clicks": 310 }
        ],
        "devices": [
          { "device": "MOBILE", "clicks": 260 }
        ]
      },
      "outputKeys": ["trend", "topQueries", "topPages", "brandedClickShare", "countries", "devices"]
    },
    {
      "id": "top_queries",
      "description": "Top 50 search queries by clicks (last 28 days)",
      "params": {},
      "outputShape": {
        "topQueries": [
          { "query": "example keyword", "clicks": 210, "impressions": 3400, "ctr": 0.062, "position": 7.1 }
        ]
      },
      "outputKeys": ["topQueries"]
    },
    {
      "id": "top_pages",
      "description": "Top 25 pages by clicks (last 28 days)",
      "params": {},
      "outputShape": {
        "topPages": [
          { "page": "https://example.com/blog/post", "clicks": 180, "impressions": 2100 }
        ]
      },
      "outputKeys": ["topPages"]
    }
  ],
  "ingest": [
    {
      "id": "search_analytics_weekly",
      "label": "GSC weekly digest",
      "description": "Weekly organic search digest: clicks, impressions, CTR, position, and top queries/pages movement",
      "mode": "SNAPSHOT",
      "projectOperation": "search_analytics",
      "sourceType": "metrics.digest.{connector}.{ingest}",
      "defaultIntervalMinutes": 10080,
      "window": { "sizeDays": 7, "lagDays": 3, "alignTo": "ISO_WEEK" },
      "suggestedDisposition": "KNOWLEDGE",
      "suggestedDomain": "marketing",
      "digest": {
        "seriesPath": "trend",
        "dateField": "date",
        "pagePath": "marketing/metrics/organic-search.md",
        "metrics": [
          { "key": "clicks", "label": "Clicks", "agg": "SUM", "field": "clicks", "direction": "UP_IS_GOOD", "minAbsolute": 50 },
          { "key": "impressions", "label": "Impressions", "agg": "SUM", "field": "impressions", "minAbsolute": 1000 },
          { "key": "ctr", "label": "CTR", "agg": "RATIO", "numerator": "clicks", "denominator": "impressions", "minAbsolute": 0.004, "minRelative": 0.10 },
          { "key": "position", "label": "Avg. position", "agg": "WEIGHTED_MEAN", "field": "position", "weightField": "impressions", "direction": "DOWN_IS_GOOD", "minAbsolute": 0.8, "minRelative": 0.05 }
        ],
        "dimensions": [
          { "key": "topQueries", "label": "Top queries", "idField": "query", "valueField": "clicks", "topN": 8, "baselineN": 25, "minAbsolute": 25, "minRelative": 0.30, "minRankMove": 5 },
          { "key": "topPages", "label": "Top pages", "idField": "page", "valueField": "clicks", "topN": 5, "baselineN": 25, "minAbsolute": 25, "minRelative": 0.30, "minRankMove": 5 }
        ]
      }
    }
  ]
}
