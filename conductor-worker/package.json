{
  "name": "conductor-worker",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "build": "tsc",
    "typecheck:fast": "tsgo --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|js)$": ["ts-jest", {"allowJs": true}]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ]
  }
}
