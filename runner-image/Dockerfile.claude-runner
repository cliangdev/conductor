# Dedicated, minimal image for claude-code workflow steps only.
#
# The general-purpose conductor-runner (../Dockerfile) stays as-is for `docker` steps and bundles
# Python and the Docker CLI for that use case. This image deliberately omits those two — no
# language runtime, no container tooling — to stay small, fast to cold-start on Cloud Run, and
# usable for any project type rather than biased toward one stack. Project-specific tooling (a
# language SDK, a Claude Code skill) belongs in a derived image, not here — see "Choosing an
# image" in docs/workflows.md.
#
# It does include git, gh, curl, and jq: not because conductor-claude-entrypoint needs them (it's
# Node built-ins only — see its own header comment), but because claude's Bash tool does. The
# `credentials:` mechanism (connector-issued runtime credentials, e.g. a GitHub token) assumes the
# container can act on them itself — `gh pr checkout`, `gh pr comment`, a `curl` against an API, a
# `jq` filter on the JSON response — regardless of what language the target project is in.
#
# The Claude CLI version pin below must move in lockstep with the pin in ../Dockerfile — see
# RunnerImage.java for the full list of places the version is duplicated.
FROM node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    gnupg \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (gh) — same apt-repo approach as ../Dockerfile, minus lsb-release (only
# needed there for the Docker CLI's repo, which this image doesn't install).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Claude CLI pinned (same version as ../Dockerfile — bump deliberately, verify against the exit
# taxonomy in conductor-claude-entrypoint.mjs when upgrading). @cliangdev/conductor (the CLI/MCP
# server) is installed at an exact version too: Publish Claude Runner Image passes
# CONDUCTOR_TOOLS_VERSION as conductor-tools/package.json's version, once it is on npm, and rebuilds after
# every CLI release, so the MCP tools a built-in workflow lists never fall behind the CLI. This ARG's
# default only covers a local build. The entrypoint reads CONDUCTOR_TOOLS_VERSION to run this global
# install's `conductor mcp` (see writeMcpConfig) and logs it at container start. Installed with npm's
# default (ephemeral) cache, then cleaned — that cache would otherwise sit in the image holding tarballs
# already extracted into node_modules, pure waste.
ARG CONDUCTOR_TOOLS_VERSION=0.53.2
ENV CONDUCTOR_TOOLS_VERSION=${CONDUCTOR_TOOLS_VERSION}
# The entrypoint runs this global install's `conductor mcp` directly (no npx copy, no network at job start).
# ffprobe-static ships every platform's binaries (~350 MB): keep only linux/x64, the platform this image is.
RUN npm install -g @anthropic-ai/claude-code@2.1.206 @cliangdev/conductor@${CONDUCTOR_TOOLS_VERSION} \
    && npm cache clean --force \
    && conductor --version \
    && for bin in $(find /usr/local/lib/node_modules -type d -path '*/ffprobe-static/bin'); do \
         find "$bin" -mindepth 1 -maxdepth 1 ! -name linux -exec rm -rf {} + ; \
         find "$bin/linux" -mindepth 1 -maxdepth 1 ! -name x64 -exec rm -rf {} + ; \
       done

# The pinned CLIs must not self-update at container start: that would reintroduce version drift and
# a startup-time network dependency this image is specifically built to avoid.
ENV DISABLE_AUTOUPDATER=1

# Declares this image honors the Conductor runner contract (conductor-claude-entrypoint's
# log/exit-code/callback protocol — see docs/workflows.md#runner-image). Checked by
# GcpConnector.verifyImage() via the Docker Registry v2 manifest/config-blob API when a BYO Cloud
# Run runtime target provisions; bump the value on a breaking contract change.
LABEL dev.conductor.runner.protocol="1"

# Create non-root user. node:22-slim already ships a `node` user, but we create a dedicated
# `runner` user to match ../Dockerfile's contract (uid/gid-agnostic, same username either image).
RUN useradd -m -s /bin/bash runner

# Create workspace/outputs/inputs directories and the self-reporting entrypoint, owned by the
# runner user. No default ENTRYPOINT/CMD — same contract as conductor-runner: claude-code steps
# invoke conductor-claude-entrypoint explicitly.
RUN mkdir -p /conductor/workspace /conductor/outputs /conductor/inputs \
    && chown -R runner:runner /conductor
COPY --chmod=755 conductor-claude-entrypoint.mjs /usr/local/bin/conductor-claude-entrypoint
# Shared protocol helpers, imported by the entrypoint as ./runner-protocol.mjs (same directory).
COPY --chmod=644 runner-protocol.mjs /usr/local/bin/runner-protocol.mjs

USER runner
WORKDIR /conductor/workspace
